<Window x:Class="CanvaStage.Windows.Views.OutputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CanvaStage.Windows.Controls"
        Title="Canva Stage Output"
        Icon="pack://application:,,,/Assets/canva-stage.ico"
        Width="1000"
        Height="560"
        MinWidth="640"
        MinHeight="360"
        Background="#101113"
        Foreground="#F7F8FA"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        KeyDown="OutputWindowKeyDown">
    <Grid>
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Background" Value="#101113" />
            </Style>
        </Grid.Style>
        <Grid x:Name="PreviewSurface" Background="#101113" ClipToBounds="True">
        <Grid x:Name="TransitionSurface">
        <TextBlock Text="OUTPUT IS BLANK"
                   Foreground="#8C929C"
                   FontSize="26"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBlank}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <Grid DataContext="{Binding}" Background="{Binding MirrorBackground}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMirror}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Image Source="{Binding FallbackImage}"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center">
                <Image.Style>
                    <Style TargetType="Image">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasFallbackImage}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Image.Style>
            </Image>
            <Grid x:Name="MirrorFallbackBounds" Margin="72">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasFallbackImage}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Viewbox StretchDirection="DownOnly">
                    <StackPanel x:Name="MirrorFallbackContent" Width="{Binding ActualWidth, ElementName=MirrorFallbackBounds}">
                        <Border Background="{Binding MirrorAccent}" Height="16" Margin="0,0,0,28" />
                        <TextBlock Text="{Binding Page.Title}" FontSize="58" FontWeight="Bold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding PrimaryText}" FontSize="30" Margin="0,26,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Viewbox>
            </Grid>
            <TextBlock x:Name="MirrorClock" Text="{Binding CurrentTime}"
                       FontFamily="{Binding Snapshot.Appearance.FontFamily}" FontSize="{Binding MirrorClockFontSize}"
                       FontWeight="{Binding ClockFontWeight}" Foreground="White" Margin="28"
                       HorizontalAlignment="{Binding MirrorClockAlignment}" VerticalAlignment="Bottom">
                <TextBlock.Effect><DropShadowEffect Color="Black" BlurRadius="5" ShadowDepth="2" Opacity="0.85" /></TextBlock.Effect>
                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers><DataTrigger Binding="{Binding ShowMirrorClock}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                </Style></TextBlock.Style>
            </TextBlock>
        </Grid>

        <Grid Background="{Binding BackgroundBrush}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMonitor}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid Margin="70">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="MonitorClock" Grid.Row="0"
                           Text="{Binding CurrentTime}"
                           Foreground="{Binding AccentBrush}"
                           FontSize="{Binding ClockFontSize}"
                           FontWeight="{Binding ClockFontWeight}"
                           HorizontalAlignment="Right">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowClock}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <controls:FittedTextHost x:Name="PrimaryTextHost" Grid.Row="1"
                                         RequestedFontSize="{Binding EffectiveFontSize}">
                    <TextBlock x:Name="PrimaryText" Text="{Binding PrimaryText}"
                               Foreground="{Binding TextBrush}"
                               FontFamily="{Binding Snapshot.Appearance.FontFamily}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               TextAlignment="Center" />
                </controls:FittedTextHost>
                <Image Grid.Row="1"
                       Source="{Binding FallbackImage}"
                       Stretch="Uniform"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowFallbackImage}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
                <Border Grid.Row="2" BorderBrush="{Binding AccentBrush}" BorderThickness="0,1,0,0" Padding="0,22,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowNextLine}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="NEXT" Foreground="{Binding AccentBrush}" FontSize="18" FontWeight="Bold" />
                        <TextBlock x:Name="NextLineText" Text="{Binding NextLine}"
                                   Foreground="{Binding NextLineBrush}"
                                   FontFamily="{Binding Snapshot.Appearance.FontFamily}"
                                   FontSize="{Binding NextLineFontSize}"
                                   FontWeight="{Binding NextLineFontWeight}"
                                   Margin="0,7,0,0"
                                   TextWrapping="NoWrap" TextTrimming="WordEllipsis" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
        <Image x:Name="TransitionOverlay" Stretch="Fill" IsHitTestVisible="False" Visibility="Collapsed" />
        </Grid>
        <Border Background="Black">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsOutputBlanked}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
        </Grid>
        <Button Content="×"
                Click="CloseOutput"
                ToolTip="Close confidence output (Escape)"
                Width="56"
                Height="56"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,10,10,0"
                FontSize="32"
                FontWeight="Light"
                Foreground="#F7F8FA"
                Background="#99000000"
                BorderThickness="0">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.9" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</Window>
