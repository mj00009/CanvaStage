<Window x:Class="CanvaStage.Windows.Views.OutputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Canva Stage Output"
        Width="1000"
        Height="560"
        MinWidth="640"
        MinHeight="360"
        Background="#101113"
        Foreground="#F7F8FA"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        KeyDown="OutputWindowKeyDown">
    <Grid>
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Background" Value="#101113" />
            </Style>
        </Grid.Style>
        <TextBlock Text="OUTPUT IS BLANK"
                   Foreground="#8C929C"
                   FontSize="26"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBlank}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <Grid DataContext="{Binding}" Background="{Binding MirrorBackground}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMirror}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Image Source="{Binding FallbackImage}"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center">
                <Image.Style>
                    <Style TargetType="Image">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasFallbackImage}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Image.Style>
            </Image>
            <StackPanel Margin="72" VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasFallbackImage}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Border Background="{Binding MirrorAccent}" Height="16" Margin="0,0,0,28" />
                <TextBlock Text="{Binding Page.Title}" FontSize="58" FontWeight="Bold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding PrimaryText}" FontSize="30" Margin="0,26,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <Grid Background="{Binding BackgroundBrush}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMonitor}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid Margin="70">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Text="{Binding CurrentTime}"
                           Foreground="{Binding AccentBrush}"
                           FontSize="28"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Right">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowClock}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Grid.Row="1"
                           Text="{Binding PrimaryText}"
                           Foreground="{Binding TextBrush}"
                           FontFamily="{Binding Snapshot.Appearance.FontFamily}"
                           FontSize="{Binding EffectiveFontSize}"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           TextAlignment="Center" />
                <Image Grid.Row="1"
                       Source="{Binding FallbackImage}"
                       Stretch="Uniform"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasFallbackImage}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
                <Border Grid.Row="2" BorderBrush="{Binding AccentBrush}" BorderThickness="0,1,0,0" Padding="0,22,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowNextLine}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="NEXT" Foreground="{Binding AccentBrush}" FontSize="18" FontWeight="Bold" />
                        <TextBlock Text="{Binding NextLine}" Foreground="{Binding TextBrush}" FontSize="30" Margin="0,7,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
        <Button Content="×"
                Click="CloseOutput"
                ToolTip="Close confidence output (Escape)"
                Width="56"
                Height="56"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,10,10,0"
                FontSize="32"
                FontWeight="Light"
                Foreground="#F7F8FA"
                Background="#99000000"
                BorderThickness="0">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.9" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</Window>
