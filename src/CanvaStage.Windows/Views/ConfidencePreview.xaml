<UserControl x:Class="CanvaStage.Windows.Views.ConfidencePreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Copy the existing output visual; never reflow text at preview size. -->
    <Grid Background="#080B10" ClipToBounds="True">
        <Rectangle>
            <Rectangle.Fill>
                <VisualBrush x:Name="OutputBrush" Visual="{Binding OutputPreviewSurface}"
                             Stretch="Uniform" AlignmentX="Center" AlignmentY="Center" />
            </Rectangle.Fill>
        </Rectangle>
    </Grid>
</UserControl>
