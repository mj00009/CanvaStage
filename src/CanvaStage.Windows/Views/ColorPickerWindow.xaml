<Window x:Class="CanvaStage.Windows.Views.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose confidence-display color"
        Icon="pack://application:,,,/Assets/canva-stage.ico"
        Width="620"
        Height="650"
        MinWidth="620"
        MinHeight="650"
        Background="{StaticResource SurfaceBrush}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="ColorSwatchButton" TargetType="Button">
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SwatchBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SwatchBorder" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SwatchBorder" Property="BorderBrush" Value="White" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Choose a color" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Select a dependable preset, choose from the spectrum, or enter a six-digit hex value." Style="{StaticResource MutedText}" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,22,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="86" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="SelectedColorPreview" Width="68" Height="68" HorizontalAlignment="Left" BorderBrush="{StaticResource BorderBrush}" BorderThickness="2" CornerRadius="10" />
            <StackPanel Grid.Column="1">
                <TextBlock Text="Hex color" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="HexInput" MaxLength="7" FontFamily="Consolas" FontSize="18" TextChanged="OnHexTextChanged" />
                <TextBlock x:Name="ValidationMessage" Text="Use the format #RRGGBB." Style="{StaticResource MutedText}" Margin="0,6,0,0" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2">
            <TextBlock Text="Common confidence-display colors" Style="{StaticResource FieldLabel}" />
            <UniformGrid Columns="8">
                <Button Style="{StaticResource ColorSwatchButton}" Background="#000000" Tag="#000000" ToolTip="Black" Click="OnSwatchClick" />
                <Button Style="{StaticResource ColorSwatchButton}" Background="#101113" Tag="#101113" ToolTip="Soft black" Click="OnSwatchClick" />
                <Button Style="{StaticResource ColorSwatchButton}" Background="#232323" Tag="#232323" ToolTip="Charcoal" Click="OnSwatchClick" />
                <Button Style="{StaticResource ColorSwatchButton}" Background="#F7FDF5" Tag="#F7FDF5" ToolTip="Warm white" Click="OnSwatchClick" />
                <Button Style="{StaticResource ColorSwatchButton}" Background="#FFFFFF" Tag="#FFFFFF" ToolTip="White" Click="OnSwatchClick" />
                <Button Style="{StaticResource ColorSwatchButton}" Background="#75E6C8" Tag="#75E6C8" ToolTip="Mint" Click="OnSwatchClick" />
                <Button Style="{StaticResource ColorSwatchButton}" Background="#8454F4" Tag="#8454F4" ToolTip="Purple" Click="OnSwatchClick" />
                <Button Style="{StaticResource ColorSwatchButton}" Background="#55D879" Tag="#55D879" ToolTip="Green" Click="OnSwatchClick" />
                <Button Style="{StaticResource ColorSwatchButton}" Background="#4FA3FF" Tag="#4FA3FF" ToolTip="Blue" Click="OnSwatchClick" />
                <Button Style="{StaticResource ColorSwatchButton}" Background="#F5C451" Tag="#F5C451" ToolTip="Gold" Click="OnSwatchClick" />
                <Button Style="{StaticResource ColorSwatchButton}" Background="#FB7E8C" Tag="#FB7E8C" ToolTip="Coral" Click="OnSwatchClick" />
                <Button Style="{StaticResource ColorSwatchButton}" Background="#FF3B30" Tag="#FF3B30" ToolTip="Red" Click="OnSwatchClick" />
                <Button Style="{StaticResource ColorSwatchButton}" Background="#FF9500" Tag="#FF9500" ToolTip="Orange" Click="OnSwatchClick" />
                <Button Style="{StaticResource ColorSwatchButton}" Background="#AF52DE" Tag="#AF52DE" ToolTip="Violet" Click="OnSwatchClick" />
                <Button Style="{StaticResource ColorSwatchButton}" Background="#5AC8FA" Tag="#5AC8FA" ToolTip="Sky blue" Click="OnSwatchClick" />
                <Button Style="{StaticResource ColorSwatchButton}" Background="#B8C1D1" Tag="#B8C1D1" ToolTip="Silver" Click="OnSwatchClick" />
            </UniformGrid>
        </StackPanel>

        <TextBlock Grid.Row="3" Text="Color spectrum" Style="{StaticResource FieldLabel}" Margin="0,10,0,7" />
        <Border x:Name="SpectrumSurface"
                Grid.Row="4"
                MinHeight="190"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                ClipToBounds="True"
                Cursor="Cross"
                MouseLeftButtonDown="OnSpectrumMouseDown"
                MouseLeftButtonUp="OnSpectrumMouseUp"
                MouseMove="OnSpectrumMouseMove">
            <Grid>
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Color="#FFFF0000" Offset="0" />
                            <GradientStop Color="#FFFFFF00" Offset="0.167" />
                            <GradientStop Color="#FF00FF00" Offset="0.333" />
                            <GradientStop Color="#FF00FFFF" Offset="0.5" />
                            <GradientStop Color="#FF0000FF" Offset="0.667" />
                            <GradientStop Color="#FFFF00FF" Offset="0.833" />
                            <GradientStop Color="#FFFF0000" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Color="#00000000" Offset="0" />
                            <GradientStop Color="#FF000000" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Canvas IsHitTestVisible="False">
                    <Ellipse x:Name="SpectrumMarker" Width="16" Height="16" Stroke="White" StrokeThickness="2" Fill="Transparent" Visibility="Collapsed" />
                </Canvas>
            </Grid>
        </Border>

        <Grid Grid.Row="5" Margin="0,22,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="Changes apply immediately after you choose the color." Style="{StaticResource MutedText}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Cancel" IsCancel="True" Style="{StaticResource SecondaryButton}" />
            <Button Grid.Column="2" Content="Choose color" IsDefault="True" Style="{StaticResource PrimaryButton}" Margin="0" Click="OnChooseColor" />
        </Grid>
    </Grid>
</Window>
