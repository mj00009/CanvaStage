<Window x:Class="CanvaStage.Windows.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:CanvaStage.Core.Models;assembly=CanvaStage.Core"
        xmlns:views="clr-namespace:CanvaStage.Windows.Views"
        xmlns:vm="clr-namespace:CanvaStage.Windows.ViewModels"
        Title="Canva Stage"
        Icon="pack://application:,,,/Assets/canva-stage.ico"
        Width="1380"
        Height="900"
        MinWidth="600"
        MinHeight="420"
        Topmost="{Binding IsOperatorTopmost}"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{StaticResource SurfaceBrush}">
      <Grid x:Name="FullViewRoot">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="286" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="Sidebar" Grid.Column="0" Background="#0A0E15" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="20,26,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Image Grid.Row="0"
                       Source="pack://application:,,,/Assets/canva-stage-logo-full-option-2.png"
                       Height="88"
                       Stretch="Uniform"
                       HorizontalAlignment="Left"
                       Margin="2,0,0,30" />
                <StackPanel Grid.Row="1">
                    <TextBlock Text="SUNDAY WORKFLOW" Style="{StaticResource EyebrowText}" Margin="12,0,0,8" />
                    <RadioButton GroupName="OperatorSection" IsChecked="{Binding IsLiveControlSelected}" Style="{StaticResource SideNavButton}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="◉" Foreground="{StaticResource AccentHoverBrush}" Margin="0,0,12,0" /><TextBlock Text="Live control" /></StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="OperatorSection" IsChecked="{Binding IsPresentationSelected}" Style="{StaticResource SideNavButton}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="▤" Foreground="{StaticResource AccentHoverBrush}" Margin="0,0,12,0" /><TextBlock Text="Presentation" /></StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="OperatorSection" IsChecked="{Binding IsDisplaysSelected}" Style="{StaticResource SideNavButton}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="▣" Foreground="{StaticResource AccentHoverBrush}" Margin="0,0,12,0" /><TextBlock Text="Displays" /></StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="OperatorSection" IsChecked="{Binding IsSetupDiagnosticsSelected}" Style="{StaticResource SideNavButton}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="⌕" Foreground="{StaticResource AccentHoverBrush}" Margin="0,0,12,0" /><TextBlock Text="Setup &amp; diagnostics" /></StackPanel>
                    </RadioButton>
                </StackPanel>
                <Border x:Name="SidebarFooter" Grid.Row="3" Background="#111824" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" VerticalAlignment="Bottom">
                    <StackPanel>
                        <TextBlock Text="PRESENTER SYNC" Style="{StaticResource EyebrowText}" />
                        <TextBlock Text="CanvaStage automatically follows a matching Canva Presenter window. Manual controls remain available." Style="{StaticResource MutedText}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid x:Name="MainContent" Grid.Column="1" Margin="30,24,30,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <ComboBox x:Name="NarrowNavigation" Visibility="Collapsed" SelectedValue="{Binding ActiveSection}" SelectedValuePath="Tag" Margin="0,0,0,10">
                        <ComboBoxItem Content="Live control" Tag="{x:Static vm:OperatorSection.LiveControl}" />
                        <ComboBoxItem Content="Presentation" Tag="{x:Static vm:OperatorSection.Presentation}" />
                        <ComboBoxItem Content="Displays" Tag="{x:Static vm:OperatorSection.Displays}" />
                        <ComboBoxItem Content="Setup &amp; diagnostics" Tag="{x:Static vm:OperatorSection.SetupDiagnostics}" />
                    </ComboBox>
                    <TextBlock Text="{Binding OperatorPageTitle}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{Binding OperatorPageSubtitle}" Style="{StaticResource MutedText}" Margin="0,5,0,0" />
                    <WrapPanel Margin="0,10,0,0">
                        <TextBlock Text="{Binding PresenterSyncSummary}" Foreground="{Binding PresenterSyncBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0" ToolTip="{Binding CanvaPresenterTrackingStatus}" />
                        <Button Content="{Binding PresenterSyncButtonText}" Command="{Binding TogglePresenterSyncCommand}" Style="{StaticResource SecondaryButton}" Padding="12,6" />
                        <Button Content="Choose window" Command="{Binding TestSetupCommand}" Style="{StaticResource TextButton}" />
                    </WrapPanel>
                </StackPanel>
                <WrapPanel Grid.Row="1" Margin="0,14,0,0" HorizontalAlignment="Right">
                    <Border Style="{StaticResource LiveStatusCard}" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="●" Foreground="{StaticResource SuccessBrush}" Margin="0,0,8,0" /><TextBlock Text="{Binding LiveReadinessText}" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="SemiBold" /></StackPanel>
                    </Border>
                    <Button Content="Compact view" Click="EnterCompactView" Style="{StaticResource SecondaryButton}" Margin="0,0,12,0" />
                    <ToggleButton Content="Always on top" IsChecked="{Binding IsOperatorTopmost}" Style="{StaticResource SecondaryToggle}" Margin="0,0,12,0" />
                    <Button Content="Run checks" Command="{Binding TestSetupCommand}" Style="{StaticResource SecondaryButton}" Margin="0" />
                </WrapPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                <Grid x:Name="LiveControlGrid">
                    <Grid.Style>
                        <Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsLiveControlSelected}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
                    </Grid.Style>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="LiveOptionsColumn" Width="300" /></Grid.ColumnDefinitions>
                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource PanelCard}" Margin="0,0,18,16">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="CONFIDENCE OUTPUT" Style="{StaticResource EyebrowText}" /><TextBlock Text="  •  " Foreground="{StaticResource MutedTextBrush}" /><TextBlock Text="{Binding OutputMode}" Foreground="{StaticResource AccentHoverBrush}" FontWeight="SemiBold" /></StackPanel>
                            <Border Grid.Row="1" Style="{StaticResource PreviewFrame}" Padding="0" Margin="0,14,0,18" Height="365">
                                <views:ConfidencePreview />
                            </Border>
                            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <ToggleButton Grid.Column="0" Content="Mirror" IsChecked="{Binding IsMirrorSelected}" Style="{StaticResource SegmentButton}" Margin="0" />
                                <ToggleButton Grid.Column="2" Content="Monitor" IsChecked="{Binding IsMonitorSelected}" Style="{StaticResource SegmentButton}" Margin="0" />
                                <Button Grid.Column="4" Content="Open Preview" Command="{Binding PreviewCommand}" Style="{StaticResource SecondaryButton}" Margin="0" />
                                <Button Grid.Column="5" Content="Start output" Command="{Binding StartOutputCommand}" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" />
                            </Grid>
                        </Grid>
                    </Border>
                    <StackPanel x:Name="LiveOptionsPanel" Grid.Row="0" Grid.Column="1">
                        <Border Style="{StaticResource PanelCard}">
                            <StackPanel><TextBlock Text="Sunday controls" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{Binding PresenterSyncSummary}" Foreground="{Binding PresenterSyncBrush}" FontWeight="SemiBold" Margin="0,12,0,6" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding CanvaPresenterTrackingStatus}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                <WrapPanel Margin="0,12,0,12">
                                    <Button Content="{Binding PresenterSyncButtonText}" Command="{Binding TogglePresenterSyncCommand}" Style="{StaticResource SecondaryButton}" />
                                    <Button Content="Choose window" Command="{Binding TestSetupCommand}" Style="{StaticResource TextButton}" />
                                </WrapPanel>
                                <TextBlock Text="Changing pages here pauses sync until you resume." Style="{StaticResource MutedText}" Margin="0,0,0,12" TextWrapping="Wrap" />
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="‹" Command="{Binding PreviousPageCommand}" Style="{StaticResource IconButton}" />
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center"><TextBlock Text="{Binding CurrentPageNumber}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center" /><TextBlock Text="{Binding PageLabel}" Style="{StaticResource MutedText}" HorizontalAlignment="Center" /></StackPanel>
                                    <Button Grid.Column="2" Content="›" Command="{Binding NextPageCommand}" Style="{StaticResource IconButton}" />
                                </Grid>
                                <TextBlock Text="{Binding SelectedPageTitle}" Foreground="{StaticResource AccentHoverBrush}" FontWeight="SemiBold" Margin="0,18,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelCard}">
                            <StackPanel><TextBlock Text="Output options" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Layout" Style="{StaticResource FieldLabel}" Margin="0,16,0,7" /><ComboBox SelectedValue="{Binding Layout}" SelectedValuePath="Tag"><ComboBoxItem Content="Current + next" Tag="{x:Static core:MonitorLayout.CurrentAndNext}" /><ComboBoxItem Content="Current only" Tag="{x:Static core:MonitorLayout.CurrentOnly}" /><ComboBoxItem Content="Speaker focused" Tag="{x:Static core:MonitorLayout.SpeakerFocused}" /><ComboBoxItem Content="Current + next compact" Tag="{x:Static core:MonitorLayout.CurrentAndNextCompact}" /></ComboBox>
                                <TextBlock Text="Next line" Style="{StaticResource FieldLabel}" Margin="0,15,0,7" /><ComboBox SelectedValue="{Binding NextLineOption}" SelectedValuePath="Tag"><ComboBoxItem Content="First non-empty line" Tag="{x:Static core:NextLineOption.FirstNonEmptyLine}" /><ComboBoxItem Content="Next title only" Tag="{x:Static core:NextLineOption.TitleOnly}" /><ComboBoxItem Content="Hidden" Tag="{x:Static core:NextLineOption.Hidden}" /></ComboBox>
                                <CheckBox Content="Show current time" IsChecked="{Binding ShowClock}" Margin="0,16,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource PanelCard}" Margin="0">
                        <StackPanel>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,18,0"><TextBlock Text="Font" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding FontFamilies}" SelectedItem="{Binding FontFamily}" /></StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,18,0"><TextBlock Text="Size" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding FontSizes}" SelectedItem="{Binding FontSize}" /></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Contrast" Style="{StaticResource FieldLabel}" /><TextBlock Text="{Binding ContrastMessage}" Style="{StaticResource MutedText}" TextWrapping="Wrap" /></StackPanel>
                            </Grid>
                            <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,18,0"><TextBlock Text="Background" Style="{StaticResource FieldLabel}" /><DockPanel><Button Content="Change" Click="PickBackgroundColor" Style="{StaticResource TextButton}" DockPanel.Dock="Right" /><TextBox Text="{Binding BackgroundColor}" IsReadOnly="True" /></DockPanel></StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,18,0"><TextBlock Text="Text" Style="{StaticResource FieldLabel}" /><DockPanel><Button Content="Change" Click="PickTextColor" Style="{StaticResource TextButton}" DockPanel.Dock="Right" /><TextBox Text="{Binding TextColor}" IsReadOnly="True" /></DockPanel></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Accent" Style="{StaticResource FieldLabel}" /><DockPanel><Button Content="Change" Click="PickAccentColor" Style="{StaticResource TextButton}" DockPanel.Dock="Right" /><TextBox Text="{Binding AccentColor}" IsReadOnly="True" /></DockPanel></StackPanel>
                            </Grid>
                            <TextBlock Text="NEXT LINE STYLE" Style="{StaticResource EyebrowText}" Margin="0,22,0,10" />
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,18,0"><TextBlock Text="Size" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding NextLineFontSizes}" SelectedItem="{Binding NextLineFontSize}" /></StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,18,0"><TextBlock Text="Weight" Style="{StaticResource FieldLabel}" /><CheckBox Content="Bold next text" IsChecked="{Binding IsNextLineBold}" Margin="0,10,0,0" /></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Color" Style="{StaticResource FieldLabel}" /><DockPanel><Button Content="Change" Click="PickNextLineColor" Style="{StaticResource TextButton}" DockPanel.Dock="Right" /><TextBox Text="{Binding NextLineColor}" IsReadOnly="True" /></DockPanel></StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid>
                    <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsPresentationSelected}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Border Style="{StaticResource PanelCard}">
                        <StackPanel><TextBlock Text="1. Connect Canva" Style="{StaticResource SectionTitle}" /><TextBlock Text="This computer holds the church’s locally protected Canva connection. The client secret is never shown after saving." Style="{StaticResource MutedText}" Margin="0,6,0,18" TextWrapping="Wrap" />
                            <WrapPanel Margin="0,0,0,16"><Button Content="Open Canva Developers" Command="{Binding OpenCanvaDeveloperPortalCommand}" Style="{StaticResource SecondaryButton}" /><Button Content="Copy redirect URL" Command="{Binding CopyRedirectUrlCommand}" Style="{StaticResource TextButton}" /></WrapPanel>
                            <TextBox Text="{Binding RedirectUrl, Mode=OneWay}" IsReadOnly="True" Margin="0,0,0,16" />
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"><TextBlock Text="Client ID" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding CanvaClientId, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Client Secret" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding SavedSecretDescription}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                    <PasswordBox x:Name="CanvaSecretInput" PasswordChanged="CanvaSecretChanged">
                                        <PasswordBox.Style><Style TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding ShowSecretInput}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></PasswordBox.Style>
                                    </PasswordBox>
                                    <Button Content="Replace saved secret" Command="{Binding ReplaceCanvaSecretCommand}" Style="{StaticResource TextButton}" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Grid>
                            <WrapPanel Margin="0,18,0,0"><Button Content="Save configuration" Command="{Binding SaveCanvaConfigurationCommand}" Style="{StaticResource SecondaryButton}" /><Button Content="Test connection" Command="{Binding TestCanvaCommand}" Style="{StaticResource SecondaryButton}" /><Button Content="Connect Canva" Command="{Binding ConnectCanvaCommand}" Style="{StaticResource PrimaryButton}" /><Button Content="Disconnect" Command="{Binding DisconnectCanvaCommand}" Style="{StaticResource DangerButton}" /></WrapPanel>
                            <TextBlock Text="{Binding CanvaConnectionStatus}" Style="{StaticResource MutedText}" Margin="0,14,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource PanelCard}" Margin="0">
                        <StackPanel><TextBlock Text="2. Choose a Canva presentation" Style="{StaticResource SectionTitle}" /><TextBlock Text="Apply retrieves page text and Canva page images. Large decks can take several minutes to export." Style="{StaticResource MutedText}" Margin="0,6,0,18" />
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><ComboBox Grid.Column="0" ItemsSource="{Binding CanvaPresentations}" SelectedItem="{Binding SelectedCanvaPresentation}" DisplayMemberPath="Title" /><Button Grid.Column="2" Content="Refresh" Command="{Binding RefreshCanvaCommand}" Style="{StaticResource SecondaryButton}" /><Button Grid.Column="3" Content="Apply" Command="{Binding ApplyCanvaCommand}" Style="{StaticResource PrimaryButton}" Margin="0" /></Grid>
                            <TextBlock Text="{Binding SelectedPresentationSummary}" Foreground="{StaticResource AccentHoverBrush}" FontWeight="SemiBold" Margin="0,16,0,0" /><TextBlock Text="{Binding LastCanvaContentRefreshText}" Style="{StaticResource MutedText}" Margin="0,4,0,0" /><TextBlock Text="{Binding CanvaPresentationStatus}" Style="{StaticResource MutedText}" Margin="0,10,0,0" TextWrapping="Wrap" />
                            <StackPanel Margin="0,12,0,0">
                                <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsCanvaDownloadProgressVisible}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                <TextBlock Text="{Binding CanvaDownloadDescription}" Style="{StaticResource MutedText}" Margin="0,0,0,7" />
                                <ProgressBar Height="10" Minimum="0" Maximum="100" Value="{Binding CanvaDownloadProgressPercent, Mode=OneWay}" IsIndeterminate="{Binding IsCanvaDownloadProgressIndeterminate}" />
                            </StackPanel>
                            <Button Content="Use local demo deck" Command="{Binding UseDemoDeckCommand}" Style="{StaticResource TextButton}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid>
                    <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsDisplaysSelected}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                    <Border Style="{StaticResource PanelCard}"><StackPanel><TextBlock Text="Confidence display" Style="{StaticResource SectionTitle}" /><TextBlock Text="Choose the extended Windows display used by people on stage. With one display, Preview remains available for safe setup." Style="{StaticResource MutedText}" Margin="0,6,0,20" TextWrapping="Wrap" />
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding Displays}" SelectedItem="{Binding SelectedDisplay}" DisplayMemberPath="Label" /><Button Grid.Column="1" Content="Refresh displays" Command="{Binding RefreshDisplaysCommand}" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0" /></Grid>
                        <TextBlock Text="{Binding DisplayDiagnostic}" Foreground="{StaticResource AccentHoverBrush}" FontWeight="SemiBold" Margin="0,20,0,0" /><TextBlock Text="{Binding DisplayDiagnosticDetail}" Style="{StaticResource MutedText}" Margin="0,4,0,20" TextWrapping="Wrap" />
                        <WrapPanel><Button Content="Open Preview" Command="{Binding PreviewCommand}" Style="{StaticResource SecondaryButton}" /><Button Content="Start on selected display" Command="{Binding StartOutputCommand}" Style="{StaticResource PrimaryButton}" /><Button Content="Stop output" Command="{Binding StopOutputCommand}" Style="{StaticResource DangerButton}" /></WrapPanel>
                    </StackPanel></Border>
                </Grid>

                <Grid>
                    <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsSetupDiagnosticsSelected}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                    <StackPanel><Border Style="{StaticResource PanelCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Readiness checks" Style="{StaticResource SectionTitle}" /><TextBlock Text="Checks are independent: laptop-only Preview can pass even when no confidence display is attached." Style="{StaticResource MutedText}" Margin="0,6,0,0" /></StackPanel><Button Grid.Column="1" Content="Refresh checks" Command="{Binding TestSetupCommand}" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0" VerticalAlignment="Top" /></Grid></Border>
                        <Border Style="{StaticResource PanelCard}">
                            <StackPanel>
                                <TextBlock Text="Automatic Canva Presenter sync" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="CanvaStage checks the Presenter page counter and presentation identity exposed by Windows. If identity is unavailable, confirm the correct window below. Window choices last for this session." Style="{StaticResource MutedText}" Margin="0,6,0,16" TextWrapping="Wrap" />
                                <CheckBox Content="Automatically follow Canva Presenter" IsChecked="{Binding IsPresenterSyncEnabled}" />
                                <TextBlock Text="{Binding PresenterSyncSummary}" Foreground="{Binding PresenterSyncBrush}" FontWeight="SemiBold" Margin="0,12,0,0" />
                                <TextBlock Text="{Binding CanvaPresenterTrackingStatus}" Style="{StaticResource MutedText}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                <ComboBox ItemsSource="{Binding PresenterSources}" SelectedItem="{Binding SelectedPresenterSource}" DisplayMemberPath="Label" Margin="0,14,0,8" />
                                <TextBlock Text="Confirm only if this window is showing the presentation you applied in CanvaStage. A different design ID or page count will still block sync." Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="Confirm selected window" Command="{Binding ConfirmPresenterWindowCommand}" Style="{StaticResource SecondaryButton}" />
                                    <Button Content="Choose automatically" Command="{Binding AutomaticPresenterWindowCommand}" Style="{StaticResource TextButton}" />
                                    <Button Content="{Binding PresenterSyncButtonText}" Command="{Binding TogglePresenterSyncCommand}" Style="{StaticResource SecondaryButton}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <UniformGrid Columns="2"><Border Style="{StaticResource DiagnosticCard}"><StackPanel><TextBlock Text="Canva connection" Style="{StaticResource FieldLabel}" /><TextBlock Text="{Binding CanvaDiagnostic}" Foreground="{StaticResource AccentHoverBrush}" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="{Binding CanvaDiagnosticDetail}" Style="{StaticResource MutedText}" Margin="0,8,0,0" TextWrapping="Wrap" /></StackPanel></Border><Border Style="{StaticResource DiagnosticCard}"><StackPanel><TextBlock Text="Presentation source" Style="{StaticResource FieldLabel}" /><TextBlock Text="{Binding PresentationDiagnostic}" Foreground="{StaticResource AccentHoverBrush}" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="{Binding PresentationDiagnosticDetail}" Style="{StaticResource MutedText}" Margin="0,8,0,0" TextWrapping="Wrap" /></StackPanel></Border><Border Style="{StaticResource DiagnosticCard}"><StackPanel><TextBlock Text="Confidence display" Style="{StaticResource FieldLabel}" /><TextBlock Text="{Binding DisplayDiagnostic}" Foreground="{StaticResource AccentHoverBrush}" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="{Binding DisplayDiagnosticDetail}" Style="{StaticResource MutedText}" Margin="0,8,0,0" TextWrapping="Wrap" /></StackPanel></Border><Border Style="{StaticResource DiagnosticCard}"><StackPanel><TextBlock Text="Preview output" Style="{StaticResource FieldLabel}" /><TextBlock Text="{Binding PreviewDiagnostic}" Foreground="{StaticResource SuccessBrush}" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="{Binding PreviewDiagnosticDetail}" Style="{StaticResource MutedText}" Margin="0,8,0,0" TextWrapping="Wrap" /></StackPanel></Border><Border Style="{StaticResource DiagnosticCard}"><StackPanel><TextBlock Text="Manual page control" Style="{StaticResource FieldLabel}" /><TextBlock Text="{Binding ManualControlDiagnostic}" Foreground="{StaticResource SuccessBrush}" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="{Binding ManualControlDiagnosticDetail}" Style="{StaticResource MutedText}" Margin="0,8,0,0" TextWrapping="Wrap" /></StackPanel></Border></UniformGrid>
                    </StackPanel>
                </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>
      </Grid>

      <Border x:Name="CompactViewRoot"
              Visibility="Collapsed"
              Style="{StaticResource PanelCard}"
              Margin="12"
              Padding="14">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="CanvaStage" Foreground="{StaticResource PrimaryTextBrush}" FontSize="18" FontWeight="SemiBold" />
            </StackPanel>
            <ToggleButton Grid.Column="1" Content="On top" IsChecked="{Binding IsOperatorTopmost}" Style="{StaticResource SecondaryToggle}" Margin="8,0,0,0" Padding="10,7" />
            <Button Grid.Column="2" Content="Full view" Click="ExitCompactView" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Padding="10,7" />
          </Grid>
          <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding PresenterSyncSummary}" Foreground="{Binding PresenterSyncBrush}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" ToolTip="{Binding CanvaPresenterTrackingStatus}" />
            <Button Grid.Column="1" Content="{Binding PresenterSyncButtonText}" Command="{Binding TogglePresenterSyncCommand}" Style="{StaticResource SecondaryButton}" Padding="8,5" Margin="8,0,0,0" />
          </Grid>
          <Border Grid.Row="2" Style="{StaticResource PreviewFrame}" Padding="0" Margin="0,12">
            <Viewbox Stretch="Uniform">
              <Grid Width="560" Height="350"><views:ConfidencePreview /></Grid>
            </Viewbox>
          </Border>
          <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <ToggleButton Grid.Column="0" Content="Mirror" IsChecked="{Binding IsMirrorSelected}" Style="{StaticResource SegmentButton}" Margin="0" />
            <ToggleButton Grid.Column="2" Content="Monitor" IsChecked="{Binding IsMonitorSelected}" Style="{StaticResource SegmentButton}" Margin="0" />
          </Grid>
        </Grid>
      </Border>
    </Grid>
</Window>
