{
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["dom", "dom.iterable", "es2018", "es2019.array", "es2019.object", "es2019.string", "es2020.promise", "es2020.string"],
    "types": ["node", "webpack-env"],
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "target": "ES2019",
    "sourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": "./",
    "paths": {
      "styles/*": ["./styles/*"]
    }
  },
  "include": ["./src/**/*", "./styles/**/*", "./declarations/**/*"]
}
